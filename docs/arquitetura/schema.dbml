// Oficina Mecanica - modelo relacional
// Importe este arquivo em https://dbdiagram.io
//
// Fonte de verdade:
//   * cliente ................ local/init.sql (este repositorio). E a UNICA tabela
//                              que a Lambda consome (somente SELECT).
//   * demais tabelas ......... prisma/schema.prisma + prisma/migrations do repo da
//                              aplicacao Fase 2 (guilhermeqmaia/software-architecture-tech-challenge,
//                              commit 8138156). Tipos conforme o SQL gerado pelo Prisma:
//                              ids em TEXT (uuid v4 gerado pela aplicacao),
//                              datas em TIMESTAMP(3), Decimal -> DECIMAL(65,30),
//                              Float -> DOUBLE PRECISION, Json -> JSONB.
//
// Divergencia conhecida: no monolito a tabela cliente tem id TEXT, datas
// TIMESTAMP(3) e NAO possui a coluna `ativo` (adicionada apenas no banco local
// para exercitar o cenario 403). Ver docs/arquitetura/banco-de-dados.md, secao 1.

Project oficina_mecanica {
  database_type: 'PostgreSQL'
  Note: '''
    Lambda de autenticacao por CPF (Fase 3) + dominio da oficina (Fase 2).
    A Lambda le apenas `cliente`; todas as escritas sao do monolito NestJS.
  '''
}

// ---------------------------------------------------------------------------
// Tabela consumida pela Lambda (schema real de local/init.sql)
// ---------------------------------------------------------------------------

Table cliente [headercolor: #2D6A4F] {
  id         uuid        [pk, not null, default: `gen_random_uuid()`, note: 'Vira a claim `sub` do JWT']
  nome       text        [not null]
  cpf_cnpj   text        [not null, unique, note: 'Pode estar gravado com ou sem mascara; a Lambda compara regexp_replace(cpf_cnpj, \'[^0-9]\', \'\', \'g\') = $1']
  email      text
  telefone   text        [not null]
  ativo      boolean     [not null, default: true, note: 'Somente no banco local; em producao use CLIENTE_STATUS_COLUMN quando a coluna existir']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    cpf_cnpj [unique, name: 'cliente_cpf_cnpj_key']
    // Recomendado (nao existe hoje): indice funcional usado pelo lookup da Lambda.
    // CREATE UNIQUE INDEX cliente_cpf_cnpj_digits_idx
    //   ON cliente (regexp_replace(cpf_cnpj, '[^0-9]', '', 'g'));
  }

  Note: 'Unica tabela lida pela Lambda de autenticacao. Dona do schema: aplicacao Fase 2.'
}

// ---------------------------------------------------------------------------
// Dominio da oficina (repositorio Fase 2) - Bounded Context Autenticacao
// ---------------------------------------------------------------------------

Enum Role {
  ADMIN
  ATENDENTE
  MECANICO
  ESTOQUISTA
  CLIENTE
}

Table usuario {
  id         text         [pk, not null]
  nome       text         [not null]
  email      text         [not null, unique]
  senha_hash text         [not null]
  role       Role         [not null]
  ativo      boolean      [not null, default: true]
  created_at timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp(3) [not null]

  Note: 'Usuarios internos (atendente, mecanico, gestor). Clientes NAO tem linha aqui: autenticam por CPF via Lambda.'
}

// ---------------------------------------------------------------------------
// Bounded Context Atendimento
// ---------------------------------------------------------------------------

Enum StatusOrdemDeServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
  CANCELADA
}

Enum StatusExecucaoItem {
  PENDENTE
  EM_EXECUCAO
  CONCLUIDO
}

Table veiculo {
  id         text         [pk, not null]
  placa      text         [not null, unique, note: 'Placa antiga ou Mercosul, validada no dominio']
  marca      text         [not null]
  modelo     text         [not null]
  ano        integer      [not null]
  cliente_id text         [not null, ref: > cliente.id]
  ativo      boolean      [not null, default: true]
  created_at timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp(3) [not null]
}

Table ordem_de_servico {
  id                text                 [pk, not null]
  numero            text                 [not null, unique]
  cliente_id        text                 [not null, ref: > cliente.id, note: 'ON DELETE CASCADE']
  veiculo_id        text                 [not null, ref: > veiculo.id, note: 'ON DELETE CASCADE']
  usuario_id        text                 [ref: > usuario.id, note: 'Mecanico responsavel. ON DELETE SET NULL']
  descricao_inicial text                 [not null]
  diagnostico       text
  status            StatusOrdemDeServico [not null, default: 'RECEBIDA']
  created_at        timestamp(3)         [not null, default: `CURRENT_TIMESTAMP`]
  updated_at        timestamp(3)         [not null]

  Note: 'Aggregate root do contexto Atendimento. Maquina de estados em `status`.'
}

Table item_ordem_de_servico_servico {
  id                  text               [pk, not null]
  ordem_de_servico_id text               [not null, ref: > ordem_de_servico.id, note: 'ON DELETE CASCADE']
  servico_id          text               [not null, ref: > servico.id]
  quantidade          integer            [not null]
  preco_unitario      decimal(65,30)     [not null, note: 'Preco congelado no momento da inclusao na OS']
  status_execucao     StatusExecucaoItem [not null, default: 'PENDENTE']
  inicio_execucao     timestamp(3)
  fim_execucao        timestamp(3)
  horas_trabalhadas   "double precision"
  created_at          timestamp(3)       [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (ordem_de_servico_id, servico_id) [unique]
  }
}

Table item_ordem_de_servico_produto {
  id                               text           [pk, not null]
  item_ordem_de_servico_servico_id text           [not null, ref: > item_ordem_de_servico_servico.id, note: 'ON DELETE CASCADE']
  produto_id                       text           [not null, ref: > produto.id]
  quantidade                       integer        [not null]
  preco_unitario                   decimal(65,30) [not null, note: 'Preco congelado no momento da inclusao na OS']
  created_at                       timestamp(3)   [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (item_ordem_de_servico_servico_id, produto_id) [unique]
  }
}

Table ordem_de_servico_audit_log {
  id                  text         [pk, not null]
  ordem_de_servico_id text         [not null, ref: > ordem_de_servico.id, note: 'ON DELETE CASCADE']
  acao                text         [not null]
  status_anterior     text
  status_novo         text
  usuario_id          text         [note: 'Sem FK: preserva historico mesmo se o usuario for removido']
  metadata            jsonb
  created_at          timestamp(3) [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (ordem_de_servico_id, created_at)
  }
}

// ---------------------------------------------------------------------------
// Bounded Context Catalogo
// ---------------------------------------------------------------------------

Table servico {
  id                   text               [pk, not null]
  nome                 text               [not null]
  descricao            text
  preco_base           decimal(65,30)     [not null]
  tempo_estimado_horas "double precision" [not null]
  ativo                boolean            [not null, default: true]
  created_at           timestamp(3)       [not null, default: `CURRENT_TIMESTAMP`]
  updated_at           timestamp(3)       [not null]
}

// ---------------------------------------------------------------------------
// Bounded Context Estoque
// ---------------------------------------------------------------------------

Enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
  RESERVA
  ESTORNO_RESERVA
  BAIXA
}

Table produto {
  id                   text           [pk, not null]
  nome                 text           [not null]
  descricao            text
  preco_unitario       decimal(65,30) [not null]
  quantidade_estoque   integer        [not null]
  quantidade_reservada integer        [not null, default: 0]
  estoque_minimo       integer        [not null]
  ativo                boolean        [not null, default: true]
  created_at           timestamp(3)   [not null, default: `CURRENT_TIMESTAMP`]
  updated_at           timestamp(3)   [not null]
}

Table movimentacao_estoque {
  id                  text                    [pk, not null]
  produto_id          text                    [not null, ref: > produto.id, note: 'ON DELETE CASCADE']
  tipo                TipoMovimentacaoEstoque [not null]
  quantidade          integer                 [not null]
  estoque_resultante  integer                 [not null]
  ordem_de_servico_id text                    [note: 'Sem FK: referencia logica a ordem_de_servico.id']
  motivo              text
  usuario_id          text                    [note: 'Sem FK: referencia logica a usuario.id']
  created_at          timestamp(3)            [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (produto_id, created_at)
    ordem_de_servico_id
  }
}

// ---------------------------------------------------------------------------
// Bounded Context Notificacao
// ---------------------------------------------------------------------------

Enum TipoNotificacao {
  ORCAMENTO_PRONTO
  OS_FINALIZADA
  STATUS_OS_ALTERADO
}

Enum CanalNotificacao {
  EMAIL
}

Enum StatusNotificacao {
  PENDENTE
  ENVIADA
  FALHOU
}

Table notificacao {
  id                  text              [pk, not null]
  cliente_id          text              [not null, note: 'Sem FK fisica: referencia logica a cliente.id (contexto desacoplado)']
  ordem_de_servico_id text              [note: 'Sem FK fisica: referencia logica a ordem_de_servico.id']
  tipo                TipoNotificacao   [not null]
  canal               CanalNotificacao  [not null]
  destinatario        text              [not null]
  assunto             text              [not null]
  mensagem            text              [not null]
  status              StatusNotificacao [not null]
  erro                text
  enviada_em          timestamp(3)
  created_at          timestamp(3)      [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    cliente_id
    ordem_de_servico_id
  }
}
